@model ShelterRazor.Pages.Log2.CreateModel

<div class="container mt-5">
<div class="card shadow-sm">
<div class="card-header bg-dark text-white">
    <h4 class="mb-0">Opret Log</h4>
</div>
<div class="card-body">
    <form method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">Id</label>
            <input asp-for="Log.Id" class="form-control"/>
        </div>
        <div class="mb-0">
            <label class="form-label fw-bold">Startdato</label>
            <input asp-for="Log.Startdato" class="form-control"/>
        </div>
        <div class="mb-3">
        <label class="form-label fw-bold">Slutdato</label>
        <input asp-for="Log.Slutdato" class="form-control"/>
        </div>
        <div class="mb-3">
            <label class="form-label fw-bold">Tekst</label>
            <input asp-for="Log.Tekst" class="form-control"/>
        </div>
        <div class="mt-3">
        <input type="submit" class="btn btn-success" value="Opret"/>
        <a href="/Log2" class="btn btn-danger">Annuller</a>
        </div>
    </form>
</div>
