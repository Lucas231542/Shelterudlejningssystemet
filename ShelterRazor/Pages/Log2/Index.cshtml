@page
@model ShelterRazor.Pages.Log2.IndexModel
@{
}
<div class="container mt-5">
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Besøgslog</h4>
    </div>
<div class="card-body">
    <div class="table-responsive">
        <table class="table table-striped">

            <thead>
            <tr>
                <th>Id</th>
                <th>Startdato</th>
                <th>Slutdato</th>
                <th>Tekst</th>
                <th>ShelterId</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td>@log.Id</td>
                    <td>@log.Startdato</td>
                    <td>@log.Slutdato</td>
                    <td>@log.Tekst</td>
                    <td>@log.ShelterId</td>
                    <td>
                        <a href="/Log2/Delete?Id=@log.Id" class="btn btn-danger">Slet</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
</div>
</div>