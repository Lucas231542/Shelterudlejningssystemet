@page
@model ShelterRazor.Pages.Log2.IndexModel
@{
}
<h1>Besøgslog</h1>
<table class="table">
    <thead> 
        <tr>
            <th>Id</th>
            <th>Startdato</th>
            <th>Slutdato</th>
            <th>Tekst</th>
            <th>ShelterId</th>
        </tr>
        </thead>
        <tbody>
            @foreach (var log in Model.Logs)
            {
                <tr>
                    <td>@log.Id</td>
                    <td>@log.Startdato</td>
                    <td>@log.Slutdato</td>
                    <td>@log.Tekst</td>
                    <td>@log.ShelterId</td>
                </tr>

            <td>
                <a asp-page="Delete" asp-route-id="@log.Id">
                    Slet
                </a>
            </td>
            }
        </tbody>
        </table>
      