@page
@model ShelterRazor.Pages.Blog.CreateModel
@{
}
<div class="container mt-5">
	<div class="card shadow -sm">
		<div class="card-header bg-dark text-white">
			<h4 class="mb-o">Opret Blog opslag</h4>
		</div>
			<div class="card-body">
				<form method="post">
					<div class="mb-3">
					<label class="form-label fw-bold"> Blog Id</label>
					<input type="number" class="form-control" asp-for="Id" />
					</div>
					<div>
					<label class="form-label fw-bold"> Blog Titel</label>
					<input type="text" class="form-control" asp-for="Titel" />
					</div>
					<div>
					<label class="form-label fw-bold"> Blog Tekst</label>
					<input type="text" class="form-control" asp-for="Tekst" />
					</div>
					<div>
					<label class="form-label fw-bold"> Blog Dato</label>
					<input type="date" class="form-control" asp-for="Dato" />
					</div>
					<div>
					<label class="form-label fw-bold"> Blog Image</label>
					<select class="form-select" asp-for="ImagePath">
						@foreach (var image in Model.ImageFiles)
						{
							<option value="@image">@image</option>
						}
					</select>
					</div>

				@* se billederne i wwwroot/Images og vælg en af dem til at være blog opslagets billede *@
				<div class="mb-3">
					<img id="previewImage" src="@Model.ImagePath" alt="Preview" width="150" height="160" />
				</div>

				
				@* <input type="text" class="form-control" asp-for="@Model.ImagePath" /> *@


				<input type="submit" class="btn btn-success" value="opret blog opslag" asp-page-handler="Ok" /> 
				<input type="submit" class="btn btn-danger" value="annuller" asp-page-handler="Cancel" />

			</form>
		</div>
	</div>
	</div>

	@* dette gør at jeg kan se preview af det valgte billede *@
	<script>
		const imageSelect = document.getElementById('ImagePath'); // den får for billdeet ud fra billedets id i imagePath
		const previewImage = document.getElementById('previewImage'); // den viser det valgte billede i previewImage
		imageSelect.addEventListener('change', function() {
			previewImage.src = this.value;
	});
	</script>
