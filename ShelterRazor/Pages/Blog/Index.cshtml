@page
@using ShelterudlejningssystemetLib
@model ShelterRazor.Pages.Blog.IndexModel
@{
}
<h1>Blog Liste</h1>
<div class="row">
	<table class="table table-hover">
		<thead>
			<tr>
				<th>Id</th>
				<th>Titel</th>
				<th>Tekst</th>
				<th>Dato</th>
				<th>Image Path</th>
			</tr>
		</thead>
		<tbody>
			@foreach (Blog_opslag item in Model.Opslag.HentKommendeBlog())
			{
				<tr>
					<td>@item.Id</td>
					<td>@item.Titel</td>
					<td>@item.Tekst</td>
					<td>@item.Dato.ToShortDateString()</td>
					<td><img src="Images/mand.jpg" alt="Manden" width="50" height="60"></td>
					<td><img src="Images/FDF.jpg" alt="FDF Logo" width="50" height="60"></td>
					<td><img src="Images/th.webp" alt="Goat" width="80" height="60"></td>
					<td>
						<a href="/Blog/Delete?Id=@item.Id" class="btn btn-danger">Slet</a>
						<a href="/Blog/Edit?Id=@item.Id" class="btn btn-primary">Rediger</a>
					</td>
				</tr>
			}
		</tbody>
			</table>
		<form method="Post">
		<input type="submit" class="btn btn-primary" value="opret nyt blog opslag" asp-page-handler="Press" />
	</form>
	
</div>