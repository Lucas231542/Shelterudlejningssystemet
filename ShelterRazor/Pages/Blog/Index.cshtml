@page
@using ShelterudlejningssystemetLib
@model ShelterRazor.Pages.Blog.IndexModel
@{
}
<div class="container mt-5">
<div class="card shadow-sm">
	<div class="card-header bg-dark text-white">
		<h4 class="mb-0">Blog Liste</h4>
	</div>
	<div class="card-body">
		<div class="table-responsive">
			<table class="table table-striped">
				<thead>
				<tr>
					<th>Id</th>
					<th>Titel</th>
					<th>Tekst</th>
					<th>Dato</th>
					<th>Image Path</th>
				</tr>
				</thead>
				<tbody>
				@foreach (Blog_opslag item in Model.Opslag.HentKommendeBlog())
				{
					<tr>
						<td>@item.Id</td>
						<td>@item.Titel</td>
						<td>@item.Tekst</td>
						<td>@item.Dato.ToShortDateString()</td>
						<td>
							<img src="@item.ImagePath" alt="Blog Image" width="100" height="106" />
						</td>
						<td>
							<a href="/Blog/Delete?Id=@item.Id" class="btn btn-danger">Slet</a>
							<a href="/Blog/Edit?Id=@item.Id" class="btn btn-primary">Rediger</a>
						</td>
					</tr>
				}
				</tbody>
			</table>
			<form method="Post">
				<input type="submit" class="btn btn-primary" value="opret nyt blog opslag" asp-page-handler="Press" />
			</form>
	
		</div>
	</div>
</div>
</div>