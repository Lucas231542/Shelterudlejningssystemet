@page
@model ShelterRazor.Pages.Blog.IndexModel
@{
}
<h1>Blog Liste</h1>
<div class="row">
	<table class="table table-hover">
		<thead>
			<tr>
				<th>Id</th>
				<th>Titel</th>
				<th>Tekst</th>
				<th>Dato</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.Opslag.HentKommendeBlog())
			{
				<tr>
					<td>@item.Id</td>
					<td>@item.Titel</td>
					<td>@item.Tekst</td>
					<td>@item.Dato.ToShortDateString()</td>
				</tr>
			}
		</tbody>
			</table>
</div>