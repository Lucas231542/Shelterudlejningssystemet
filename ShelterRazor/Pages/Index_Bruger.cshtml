@page
@model ShelterRazor.Pages.Index_Bruger

@{
    Layout = "_Layout";
}


<div class="container mt-5">
<div class="card shadow-sm">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Brugere</h4>
    </div>
    <div class="card-body">
        
        <table class="table table-striped table-bordered">
            <tr>
                <th>Navn</th>
                <th>Type</th>
                <th>Tlf</th>
                <th>Email</th>
            </tr>
            @foreach (var brugere in Model.Brugere)
            {
                <tr>
                    <td>@brugere.Name</td>
                    <td>@brugere.GetType().Name</td>
                    <td>@brugere.FormatTlf()</td>
                    <td>@brugere.Email</td>
                </tr>
            }
        </table>
    </div>
</div>
</div>
