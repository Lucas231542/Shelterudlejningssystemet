@page
@model ShelterRazor.Pages.Index_Bruger

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title>Brugere</title>
</head>
<body>
<div>
    <h2>Brugere</h2>
    <table class ="table table-striped table-bordered">
    <tr>
        <th>Navn</th>
        <th>Type</th>
        <th>Tlf</th>
        <th>Email</th>
    </tr>
    @foreach (var brugere in Model.Brugere)
    {
        <tr>
            <td>@brugere.Name</td>
            <td>@brugere.GetType().Name</td>
            <td>@brugere.tlf</td>
            <td>@brugere.Email</td>
        </tr> 
    }
    </table>
</div>
</body>
</html>