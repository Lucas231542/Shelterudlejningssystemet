@page
@model ShelterRazor.Pages.Spejderkredse.Create_SpejderKredseModel
@{
}
<div class="container mt-5">
<div class="card shadow-sm">
<div class="card-header bg-dark text-white">
	<h4 class="mb-0">Opret Spejderkreds</h4>
</div>
<div class="card-body">
<form method="post">
	<div class="mb-3">
		<label class="form-label fw-bold">Spejderkreds Id</label>
		<input type="number" asp-for="@Model.KredsId" class="form-control"/>
	</div>
	<div class="mb-3">
		<label class="form-label fw-bold">Spejderkreds Navn</label>
		<input type="text" asp-for="@Model.Name" class="form-control"/>
	</div>
<div class="mb-3">
	<label class="form-label fw-bold">Antal Medlemmer</label>
	<input type="number" asp-for="@Model.Medlemmer" class="form-control"/>
</div>
<div class="mt-3">
	<input type="submit" class="btn btn-success" value="Opret spejderkreds" asp-page-handler="Ok"/>
	<input type="submit" class="btn btn-danger" value="annuller" asp-page-handler="Cancel" />
	</div>
</form>
</div>
</div>
</div>