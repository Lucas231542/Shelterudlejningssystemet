@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="bg-dark text-white p-4 rounded">
    <h1>Privacy Policy</h1>
    <p class="lead">Læs hvordan vi behandler dine personoplysninger</p>
</div>
<div class="card shadow-sm">
<div class="card-body">
    <h4>Hvilke data indsamler vi?</h4>
    <p>Vi indsamler navn, email, telefonnummer på systemets brugere.</p>
    <h4>Hvordan bruges data?</h4>
    <p>Data bruges udelukkende til administration af systemet og må ikke deles af trejdepart.</p>
    <h4>Dine rettigheder</h4>
    <p>Du har ret til at få indsigt i, ændret eller slettet dine personoplysninger. Kontakt en administrator for at gøre brug af dine rettigheder.</p>
    <h4>Kontakt</h4>
    <p>Har du spørgsmål til vores behandling af dine data, kan du kontakte os på: Admin@shelter.dk</p>
</div>
</div>