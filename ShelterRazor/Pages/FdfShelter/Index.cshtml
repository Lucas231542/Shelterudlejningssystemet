@page
@model ShelterRazor.Pages.FdfShelter.IndexModel
@{
}
<h1>Information om FDF Shelters</h1>
<a asp-page="Create">Opret Shelter</a>
<div class="row">
	<table class="table table-hover">
		<thead>
			<tr>
				<th>Shelter Navn</th>
				<th>Shelter ID</th>
				<th>Lokation</th>
				<th>Størrelse</th>
				<th>Post Nummer</th>
				<th>Slet</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var shelter in IndexModel.Shelters)
			{
				<tr>
					<td>@shelter.ShelterNavn</td>
					<td>@shelter.ShelterId</td>
					<td>@shelter.Lokation</td>
					<td>@shelter.Størrelse</td>
					<td>@shelter.PostNummer</td>
					<td>
						<form method ="post">
							<button type ="submit"
								asp-page-handler="Delete"
								asp-route-id="@shelter.ShelterId">
							Slet
							</button>

						</form>
					</td>
				</tr>
				}
	
		</tbody>
	</table>

</div>